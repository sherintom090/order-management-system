
local.file_match "spring_boot_logs" {
  path_targets = [
    {
      __path__ = "/var/log/retail/inventory-service.json",
      service  = "inventory-service",
      job      = "spring-boot",
    },
    {
      __path__ = "/var/log/retail/order-service.json",
      service  = "order-service",
      job      = "spring-boot",
    },
    {
      __path__ = "/var/log/retail/api-gateway.json",
      service  = "api-gateway",
      job      = "spring-boot",
    },
  ]
}

loki.source.file "spring_boot_logs" {
  targets    = local.file_match.spring_boot_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://retail-loki:3100/loki/api/v1/push"
  }
}
