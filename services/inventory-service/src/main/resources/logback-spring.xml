<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty
            scope="context"
            name="serviceName"
            source="spring.application.name"
            defaultValue="inventory-service"/>

    <!-- JSON Console Appender -->
    <appender name="JSON"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <customFields>
                {"service":"${serviceName}"}
            </customFields>

        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>

</configuration>
