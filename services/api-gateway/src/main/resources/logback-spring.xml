<configuration>

    <springProperty
            scope="context"
            name="serviceName"
            source="spring.application.name"
            defaultValue="api-gateway"/>

    <appender name="JSON"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>
                {"service":"${serviceName}"}
            </customFields>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>

</configuration>
